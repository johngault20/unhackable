[Unit]
Description=unhackable local failed sign-in desktop alert
After=default.target

[Service]
Type=simple
# Change this path if the repository is not at ~/unhackable.
ExecStart=/usr/bin/python3 %h/unhackable/scripts/login_alert.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
