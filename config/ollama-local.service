[Unit]
Description=Ollama local AI service (loopback only)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1
Environment=OLLAMA_PORT=11434
WorkingDirectory=/home/%u/.ollama
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/%u/.ollama /tmp

[Install]
WantedBy=default.target
